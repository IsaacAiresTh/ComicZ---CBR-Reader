# Normaliza fim de linha: LF no repositório, independentemente do SO de quem clona.
* text=auto eol=lf

# Binários — nunca normalizar.
*.png binary
*.jpg binary
*.webp binary
*.cbr binary
*.cbz binary

# Gerados: colapsados no diff do GitHub para não poluir a review.
package-lock.json linguist-generated=true -diff
packages/database/prisma/migrations/** linguist-generated=true
