// ComicZ — schema do MVP.
// O banco guarda apenas metadados: os arquivos .cbr e as paginas extraidas
// vivem no storage (ver STORAGE_ROOT no .env).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- usuarios

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  libraryItems  LibraryItem[]
  progress      ReadingProgress[]
  guides        Guide[]
  collections   Collection[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- catalogo

model Publisher {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  series Series[]
  comics Comic[]

  @@map("publishers")
}

/// UNKNOWN e o default de proposito: nao queremos afirmar "em lancamento" sobre
/// uma saga so porque ninguem preencheu o campo ainda.
enum SeriesStatus {
  UNKNOWN
  ONGOING
  COMPLETED
  HIATUS
}

model Series {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  coverPath   String?      @map("cover_path")
  startYear   Int?         @map("start_year")
  endYear     Int?         @map("end_year")
  status      SeriesStatus @default(UNKNOWN)
  /// Total planejado de edicoes da saga; null quando nao se sabe. Comparado
  /// com quantas estao no acervo para mostrar "6 de 12 edicoes".
  totalIssues Int?         @map("total_issues")
  /// Saga que existe para dar suporte a um guia, e nao para ser navegada.
  /// Some da home e do catalogo quando nao ha busca nem filtro; continua na
  /// busca por texto, no filtro por saga ou tag, na pagina da saga, nos guias,
  /// na biblioteca e por link direto. Ex.: os tie-ins de Guerras Secretas, que
  /// entraram para o guia e nao formam uma colecao que se pretenda completar.
  supporting  Boolean      @default(false)
  publisherId String?      @map("publisher_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  publisher       Publisher?       @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  comics          Comic[]
  creators        SeriesCreator[]
  collectionItems CollectionItem[]

  @@index([publisherId])
  @@map("series")
}

/// Creditos da saga inteira (roteirista, arte). Separado de ComicCreator porque
/// uma edicao pode ter um artista convidado sem que ele assine a serie.
model SeriesCreator {
  seriesId  String @map("series_id") @db.Uuid
  creatorId String @map("creator_id") @db.Uuid
  role      String @default("writer")

  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([seriesId, creatorId, role])
  @@map("series_creators")
}

model Creator {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique

  comics ComicCreator[]
  series SeriesCreator[]

  @@map("creators")
}

model Character {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  /// Uma linha: quem e. Aparece na lista e sob o nome na pagina.
  summary String?
  /// O texto da pagina. Nomes de outros personagens viram link sozinhos.
  description String?
  /// Como o personagem tambem e chamado nos textos, e so para isso: sem
  /// "Prime" aqui, uma descricao que o chame assim nao vira link.
  aliases String[] @default([])

  images CharacterImage[]
  comics ComicCharacter[]

  @@map("characters")
}

/// Imagem da pagina do personagem.
///
/// Tabela, e nao uma coluna, porque a pagina usa varias: o retrato do topo e as
/// outras distribuidas ao longo do texto. A de `position` 0 e o retrato — nao
/// existe coluna de "principal" porque a ordem ja responde isso, e duas fontes
/// para o mesmo fato divergem.
model CharacterImage {
  id          String  @id @default(uuid()) @db.Uuid
  characterId String  @map("character_id") @db.Uuid
  path        String
  /// Legenda opcional, sob a imagem.
  caption     String?
  position    Int
  /// Versao da URL da imagem: a rota de midia responde `immutable` por um ano,
  /// entao trocar o arquivo precisa mudar a URL.
  updatedAt   DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, position])
  @@map("character_images")
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique

  comics ComicTag[]

  @@map("tags")
}

model Comic {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  slug            String    @unique
  description     String?
  coverPath       String?   @map("cover_path")
  issueNumber     Int?      @map("issue_number")
  publicationDate DateTime? @map("publication_date")
  seriesId        String?   @map("series_id") @db.Uuid
  publisherId     String?   @map("publisher_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  series     Series?          @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  publisher  Publisher?       @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  file       ComicFile?
  creators   ComicCreator[]
  characters ComicCharacter[]
  tags       ComicTag[]

  libraryItems    LibraryItem[]
  progress        ReadingProgress[]
  guideItems      GuideItem[]
  collectionItems CollectionItem[]

  @@index([seriesId, issueNumber])
  @@index([title])
  @@map("comics")
}

model ComicCreator {
  comicId   String @map("comic_id") @db.Uuid
  creatorId String @map("creator_id") @db.Uuid
  role      String @default("writer")

  comic   Comic   @relation(fields: [comicId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([comicId, creatorId, role])
  @@map("comic_creators")
}

model ComicCharacter {
  comicId     String @map("comic_id") @db.Uuid
  characterId String @map("character_id") @db.Uuid

  comic     Comic     @relation(fields: [comicId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([comicId, characterId])
  @@map("comic_characters")
}

model ComicTag {
  comicId String @map("comic_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([comicId, tagId])
  @@map("comic_tags")
}

// ---------------------------------------------------------------- arquivos

enum ComicFormat {
  CBR
  CBZ
}

enum FileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model ComicFile {
  id               String      @id @default(uuid()) @db.Uuid
  comicId          String      @unique @map("comic_id") @db.Uuid
  originalFilename String      @map("original_filename")
  format           ComicFormat
  sizeBytes        BigInt      @map("size_bytes")
  pageCount        Int?        @map("page_count")
  status           FileStatus  @default(PENDING)
  storageKey       String      @map("storage_key")
  checksum         String?
  errorMessage     String?     @map("error_message")
  processedAt      DateTime?   @map("processed_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  comic Comic       @relation(fields: [comicId], references: [id], onDelete: Cascade)
  pages ComicPage[]

  @@index([status])
  @@map("comic_files")
}

model ComicPage {
  id          String @id @default(uuid()) @db.Uuid
  comicFileId String @map("comic_file_id") @db.Uuid
  index       Int
  storageKey  String @map("storage_key")
  width       Int?
  height      Int?
  sizeBytes   Int?   @map("size_bytes")

  file ComicFile @relation(fields: [comicFileId], references: [id], onDelete: Cascade)

  @@unique([comicFileId, index])
  @@map("comic_pages")
}

// ---------------------------------------------------------------- fila

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Fila simples em PostgreSQL (SELECT ... FOR UPDATE SKIP LOCKED).
/// Trocavel por Redis/BullMQ depois sem mexer no dominio.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  lastError   String?   @map("last_error")
  runAt       DateTime  @default(now()) @map("run_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, runAt])
  @@map("jobs")
}

// ---------------------------------------------------------------- biblioteca

enum LibraryStatus {
  WANT_TO_READ
  READING
  READ
}

model LibraryItem {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  comicId   String        @map("comic_id") @db.Uuid
  status    LibraryStatus @default(WANT_TO_READ)
  favorite  Boolean       @default(false)
  addedAt   DateTime      @default(now()) @map("added_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([userId, status])
  @@map("library_items")
}

model ReadingProgress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  comicId     String   @map("comic_id") @db.Uuid
  currentPage Int      @default(1) @map("current_page")
  pageCount   Int      @default(0) @map("page_count")
  completed   Boolean  @default(false)
  lastReadAt  DateTime @default(now()) @map("last_read_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([userId, lastReadAt])
  @@map("reading_progress")
}

// ---------------------------------------------------------------- guias

/// Como o guia e apresentado. GUIDE e a lista enxuta de sempre; EVENT ganha a
/// pagina de trilha em /eventos — capa grande, elenco e capitulos —, que so faz
/// sentido para saga longa o bastante para ter atos.
enum GuideKind {
  GUIDE
  EVENT
}

model Guide {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  summary     String?
  description String?
  coverPath   String?   @map("cover_path")
  published   Boolean   @default(false)
  kind        GuideKind @default(GUIDE)
  /// Cor da saga em hex ("#c2410c"). A pagina de evento a usa nos acentos —
  /// linha do tempo, selos e barra —, nunca no fundo: o tema do site continua
  /// mandando na leitura.
  accentColor String?   @map("accent_color")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items      GuideItem[]
  characters GuideCharacter[]
  nodes      GuideNode[]

  @@map("guides")
}

/// Um bloco do mapa do evento: uma saga, um arco, uma minisserie — a unidade
/// que o leitor reconhece pelo nome. O mapa liga blocos, e nao edicoes: com 138
/// edicoes numa trilha, a lista vertical fica impossivel de ler, enquanto os
/// mesmos 138 itens cabem em uma duzia de blocos.
model GuideNode {
  id      String  @id @default(uuid()) @db.Uuid
  guideId String  @map("guide_id") @db.Uuid
  label   String
  /// Uma linha sobre o que este bloco e, mostrada no card do mapa.
  note    String?
  /// Faixa horizontal (linha do mapa). 0 e a de cima.
  lane    Int
  /// Passo no eixo do tempo, da esquerda para a direita.
  coluna  Int     @map("coluna")
  /// Bloco que nao depende de nenhum outro — comeca uma leitura por aqui.
  entry   Boolean @default(false)
  /// De quais blocos este nasce. Guardado como lista, e nao como tabela de
  /// arestas: o grafo e pequeno e sempre lido inteiro junto com o guia.
  parents String[] @db.Uuid

  guide Guide       @relation(fields: [guideId], references: [id], onDelete: Cascade)
  items GuideItem[]

  @@index([guideId, lane, coluna])
  @@map("guide_nodes")
}

/// Rosto que a pagina do evento mostra antes da trilha. E do guia, e nao do
/// Character do catalogo, de proposito: o mesmo personagem aparece em sagas
/// diferentes com peso e imagem diferentes, e aqui o que importa e o papel que
/// ele tem NESTA historia.
model GuideCharacter {
  id        String  @id @default(uuid()) @db.Uuid
  guideId   String  @map("guide_id") @db.Uuid
  name      String
  /// "O vilao", "Quem paga a conta" — uma linha, nao uma biografia.
  role      String?
  imagePath String? @map("image_path")
  position  Int
  /// Versao da URL da imagem: sem isto, trocar o rosto nao tiraria o antigo do
  /// cache, que responde `immutable` por um ano.
  updatedAt DateTime @updatedAt @map("updated_at")

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, position])
  @@map("guide_characters")
}

model GuideItem {
  id       String  @id @default(uuid()) @db.Uuid
  guideId  String  @map("guide_id") @db.Uuid
  comicId  String  @map("comic_id") @db.Uuid
  position Int
  note     String?
  optional Boolean @default(false)
  /// Nome do ato a que este item pertence ("Prologo", "A guerra"). Itens
  /// seguidos com o mesmo texto viram um bloco na trilha; null fica solto.
  chapter  String?
  /// Bloco do mapa a que este item pertence. Null aparece so na trilha.
  nodeId   String? @map("node_id") @db.Uuid

  guide Guide      @relation(fields: [guideId], references: [id], onDelete: Cascade)
  comic Comic      @relation(fields: [comicId], references: [id], onDelete: Cascade)
  node  GuideNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@unique([guideId, comicId])
  @@index([guideId, position])
  @@map("guide_items")
}

/// Pasta que o proprio leitor cria dentro da biblioteca para organizar as HQs
/// do jeito dele — "Para reler", "Do Batman", "Emprestadas". Nao se confunde
/// com Series (que descreve a publicacao) nem com Guide (curadoria do acervo,
/// igual para todo mundo): esta e privada de cada usuario.
model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// Ordem escolhida pelo dono; empates caem no nome.
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  /// Duas pastas "Para reler" na mesma biblioteca so confundiriam o dono.
  @@unique([userId, name])
  @@index([userId, position])
  @@map("collections")
}

/// Um item guardado numa pasta: uma HQ avulsa OU uma saga inteira.
///
/// Guardar a saga como um item so — e nao as edicoes uma a uma — e o que faz a
/// pasta ficar legivel: "Magik" ocupa uma linha, nao nove. Espelha o que a
/// propria biblioteca ja faz, onde a saga e um card e nao 52.
///
/// Exatamente um dos dois campos e preenchido; o CHECK na migration garante
/// isso no banco, e nao so no codigo.
model CollectionItem {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  comicId      String?  @map("comic_id") @db.Uuid
  seriesId     String?  @map("series_id") @db.Uuid
  /// Posicao dentro da pasta, para o dono ordenar como quiser.
  position     Int      @default(0)
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  comic      Comic?     @relation(fields: [comicId], references: [id], onDelete: Cascade)
  series     Series?    @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  /// A mesma HQ (ou saga) nao entra duas vezes na mesma pasta. Em Postgres
  /// varios NULL convivem numa unique, entao a coluna nao usada nao atrapalha.
  @@unique([collectionId, comicId])
  @@unique([collectionId, seriesId])
  @@index([collectionId, position])
  @@map("collection_items")
}
