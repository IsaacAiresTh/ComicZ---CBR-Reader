{
  "name": "@comicz/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/mark-esm.mjs",
    "dev": "npm-run-all --parallel dev:cjs dev:esm",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "dev:cjs": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:esm": "tsc -p tsconfig.esm.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2"
  }
}
