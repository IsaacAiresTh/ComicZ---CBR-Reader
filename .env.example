# ---------- PostgreSQL (docker compose) ----------
POSTGRES_USER=comicz
POSTGRES_PASSWORD=comicz
POSTGRES_DB=comicz
POSTGRES_PORT=5433

DATABASE_URL="postgresql://comicz:comicz@localhost:5433/comicz?schema=public"

# ---------- API ----------
NODE_ENV=development
API_PORT=3333
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173

# ATENCAO: os valores abaixo servem apenas para desenvolvimento local.
# Gere segredos reais antes de expor a aplicacao em qualquer rede:
#   npm run gen:secrets
JWT_ACCESS_SECRET=dev-access-secret-troque-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-troque-me
JWT_REFRESH_TTL=7d
# Assina as URLs das paginas servidas ao <img> do leitor
PAGE_TOKEN_SECRET=dev-page-secret-troque-me
PAGE_TOKEN_TTL=2h

# ---------- Storage ----------
# Caminho absoluto ou relativo a raiz do repositorio
STORAGE_ROOT=./storage
# Area de trabalho para uploads em andamento e extracao de arquivos.
# Deixe comentado para usar <STORAGE_ROOT>/tmp — que fica no mesmo disco do
# storage. NAO aponte para /tmp: na maioria das distros ele e tmpfs (RAM), e um
# CBR de 800 MB estouraria a memoria da maquina.
# TMP_ROOT=./storage/tmp
MAX_UPLOAD_MB=1024

# ---------- Worker ----------
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1
PAGE_IMAGE_MAX_WIDTH=1600
PAGE_IMAGE_QUALITY=78

# ---------- Seed do admin ----------
# Criado por `npm run db:seed`. Troque a senha antes de qualquer deploy.
ADMIN_EMAIL=admin@comicz.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ---------- Import local (script) ----------
COMICS_SOURCE_DIR="./HQ's"
