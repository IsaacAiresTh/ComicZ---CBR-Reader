# ---------- PostgreSQL (docker compose) ----------
POSTGRES_USER=comicz
POSTGRES_PASSWORD=comicz
POSTGRES_DB=comicz
POSTGRES_PORT=5433

DATABASE_URL="postgresql://comicz:comicz@localhost:5433/comicz?schema=public"

# ---------- API ----------
NODE_ENV=development
API_PORT=3333
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173
# Quantos proxies existem na frente da API. Em dev nao ha nenhum. Em producao,
# atras do rewrite da Vercel + proxy do Render, use 2 — sem isso o rate limit
# passa a contar todos os usuarios como um cliente so. Ver docs/DEPLOY.md.
TRUST_PROXY=0
# Em producao a porta vem de PORT (injetada pelo Render); API_PORT so vale aqui.

# ATENCAO: os valores abaixo servem apenas para desenvolvimento local.
# Gere segredos reais antes de expor a aplicacao em qualquer rede:
#   npm run gen:secrets
JWT_ACCESS_SECRET=dev-access-secret-troque-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-troque-me
JWT_REFRESH_TTL=7d
# Assina as URLs das paginas servidas ao <img> do leitor
PAGE_TOKEN_SECRET=dev-page-secret-troque-me
PAGE_TOKEN_TTL=2h

# ---------- Storage ----------
# local = disco (desenvolvimento). s3 = Cloudflare R2 ou compativel (producao).
# API e worker precisam do MESMO driver: com valores diferentes, o worker grava
# as paginas onde a API nao vai procura-las.
STORAGE_DRIVER=local

# Usado apenas quando STORAGE_DRIVER=local.
# Caminho absoluto ou relativo a raiz do repositorio
STORAGE_ROOT=./storage

# Usados apenas quando STORAGE_DRIVER=s3. No R2, o endpoint e
# https://<account-id>.r2.cloudflarestorage.com e as chaves saem de um API
# Token do tipo "Object Read & Write" escopado no bucket.
# S3_BUCKET=comicz
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# O R2 nao tem regioes; o SDK exige o campo e "auto" e o valor correto.
# S3_REGION=auto
# Area de trabalho para uploads em andamento e extracao de arquivos.
# Deixe comentado para usar <STORAGE_ROOT>/tmp — que fica no mesmo disco do
# storage. NAO aponte para /tmp: na maioria das distros ele e tmpfs (RAM), e um
# CBR de 800 MB estouraria a memoria da maquina.
# TMP_ROOT=./storage/tmp
MAX_UPLOAD_MB=1024

# ---------- Worker ----------
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1
PAGE_IMAGE_MAX_WIDTH=1600
PAGE_IMAGE_QUALITY=78

# ---------- Seed do admin ----------
# Criado por `npm run db:seed`. Troque a senha antes de qualquer deploy.
ADMIN_EMAIL=admin@comicz.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ---------- Import local (script) ----------
COMICS_SOURCE_DIR="./HQ's"
