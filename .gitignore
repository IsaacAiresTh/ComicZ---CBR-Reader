# Dependências
node_modules/

# Builds
dist/
build/
*.tsbuildinfo
coverage/

# Segredos e configuração local — NUNCA versionar.
# O template versionado é o .env.example.
.env
.env.*
!.env.example

# Acervo de HQs e arquivos processados.
# São gigabytes de material protegido por direito autoral: nada disso vai
# para o repositório. O storage é recriado sozinho pela aplicação.
HQ's/
HQs/
/storage/*
!/storage/.gitkeep

# Logs e temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock
.npm
.cache/
tmp/

# Editores e SO
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Worktrees e patches de sessao do Claude Code: nao sao do projeto, e um
# `git add -A` distraido levaria um checkout inteiro para dentro do commit.
/.claude/worktrees/
/.claude/*.patch
